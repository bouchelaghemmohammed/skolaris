@page "/admin/emploi-du-temps"
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Net.Http.Json

<h3 class="mb-4">Emploi du temps — Administration</h3>

<div class="d-flex gap-3 mb-3 flex-wrap align-items-end">
    <div>
        <label class="form-label mb-1">Filtrer par groupe</label>
        <select class="form-select" style="min-width:200px" @bind="filterGroupeId">
            <option value="-1">Tous</option>
            @foreach (var g in groupes)
            {
                <option value="@g.Id">@g.Nom</option>
            }
        </select>
    </div>
    <div class="ms-auto d-flex gap-2">
        <button class="btn @(viewMode == "grid" ? "btn-primary" : "btn-outline-primary")" @onclick="ShowGrid">Grille</button>
        <button class="btn @(viewMode == "list" ? "btn-primary" : "btn-outline-primary")" @onclick="ShowList">Liste</button>
        <button class="btn btn-success" @onclick="OpenCreateModal">+ Nouveau créneau</button>
    </div>
</div>

@if (loadError != "")
{
    <div class="alert alert-danger">@loadError</div>
}
else if (creneaux == null)
{
    <p><em>Chargement...</em></p>
}
else if (viewMode == "grid")
{
    <div class="table-responsive">
        <table class="table table-bordered mb-0" style="min-width:700px; table-layout:fixed;">
            <thead>
                <tr>
                    <th style="width:80px; background:#343a40; color:white;">Heure</th>
                    <th style="background:#343a40; color:white; text-align:center;">Lundi</th>
                    <th style="background:#343a40; color:white; text-align:center;">Mardi</th>
                    <th style="background:#343a40; color:white; text-align:center;">Mercredi</th>
                    <th style="background:#343a40; color:white; text-align:center;">Jeudi</th>
                    <th style="background:#343a40; color:white; text-align:center;">Vendredi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in TimeSlots)
                {
                    <tr style="height:56px;">
                        <td style="font-size:0.8rem; color:#6c757d; vertical-align:middle; background:#f8f9fa;">@slot</td>
                        @for (int j = 0; j < 5; j++)
                        {
                            int jour = j;
                            string s = slot;
                            var cell = FilteredCreneaux.FirstOrDefault(c =>
                                c.JourSemaine == jour &&
                                string.Compare(c.HeureDebut, s) <= 0 &&
                                string.Compare(c.HeureFin, s) > 0);

                            <td style="padding:3px; vertical-align:top;">
                                @if (cell != null && cell.HeureDebut == slot)
                                {
                                    <div style="background:#0d6efd;color:white;border-radius:6px;padding:5px 7px;font-size:0.75rem;cursor:pointer;"
                                         @onclick="() => OpenEditModal(cell)">
                                        <strong>@cell.CoursNom</strong><br/>
                                        <span>@cell.EnseignantNom</span><br/>
                                        <span>@cell.HeureDebut - @cell.HeureFin</span>
                                        @if (cell.Salle != null)
                                        {
                                            <span> | @cell.Salle</span>
                                        }
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mt-2">Cliquez sur un créneau pour le modifier. Passez en vue Liste pour supprimer.</p>
}
else
{
    @if (!FilteredCreneaux.Any())
    {
        <div class="alert alert-info">Aucun créneau trouvé.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Jour</th>
                        <th>Cours</th>
                        <th>Groupe</th>
                        <th>Enseignant</th>
                        <th>Horaire</th>
                        <th>Salle</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in FilteredCreneaux.OrderBy(x => x.JourSemaine).ThenBy(x => x.HeureDebut))
                    {
                        <tr>
                            <td>@JourLabel(c.JourSemaine)</td>
                            <td>@c.CoursNom</td>
                            <td><span class="badge bg-secondary">@c.GroupeNom</span></td>
                            <td>@c.EnseignantNom</td>
                            <td>@c.HeureDebut - @c.HeureFin</td>
                            <td>@(c.Salle ?? "—")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(c)">Modifier</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(c)">Supprimer</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (showModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@modalTitle</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Cours offert *</label>
                        <select class="form-select" @bind="editing.CoursOffertId">
                            <option value="0">Choisir...</option>
                            @foreach (var co in coursOfferts)
                            {
                                <option value="@co.Id">@co.CoursNom — @co.GroupeNom</option>
                            }
                        </select>
                        @if (submitAttempted && editing.CoursOffertId == 0)
                        {
                            <div class="text-danger small">Veuillez choisir un cours offert.</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Jour *</label>
                        <select class="form-select" @bind="editing.JourSemaine">
                            <option value="0">Lundi</option>
                            <option value="1">Mardi</option>
                            <option value="2">Mercredi</option>
                            <option value="3">Jeudi</option>
                            <option value="4">Vendredi</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col mb-3">
                            <label class="form-label">Heure début *</label>
                            <input type="time" class="form-control" value="@editing.HeureDebut" @onchange="OnHeureDebutChanged" />
                        </div>
                        <div class="col mb-3">
                            <label class="form-label">Heure fin *</label>
                            <input type="time" class="form-control" value="@editing.HeureFin" @onchange="OnHeureFinChanged" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Salle</label>
                        <input class="form-control" @bind="editing.Salle" placeholder="ex: B-201" />
                    </div>
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger py-2">@modalError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="SaveCreneau">@(saving ? "Enregistrement..." : "Enregistrer")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (deletingCreneau != null)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                    <button class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Supprimer le creneau <strong>@deletingCreneau.CoursNom</strong> du <strong>@JourLabel(deletingCreneau.JourSemaine)</strong> ?</p>
                    <p class="text-muted small">Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Annuler</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmed">Supprimer</button>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
        <div class="alert alert-success shadow">
            @successMessage
            <button type="button" class="btn-close ms-3" @onclick="ClearSuccess"></button>
        </div>
    </div>
}

@code {

    private List<CreneauDto>?    creneaux;
    private List<CoursOffertDto> coursOfferts   = new();
    private List<GroupeDto>      groupes        = new();
    private int    filterGroupeId  = -1;
    private string viewMode        = "grid";
    private bool   showModal       = false;
    private bool   submitAttempted = false;
    private bool   saving          = false;
    private string modalTitle      = "";
    private string modalError      = "";
    private string successMessage  = "";
    private string loadError       = "";
    private CreneauFormDto editing         = new();
    private CreneauDto?    deletingCreneau;

    private static readonly List<string> TimeSlots = new List<string>
    {
        "07:30","08:00","08:30","09:00","09:30","10:00",
        "10:30","11:00","11:30","12:00","12:30","13:00",
        "13:30","14:00","14:30","15:00","15:30","16:00",
        "16:30","17:00","17:30","18:00","18:30","19:00",
        "19:30","20:00"
    };

    private string JourLabel(int j)
    {
        return j switch
        {
            0 => "Lundi",
            1 => "Mardi",
            2 => "Mercredi",
            3 => "Jeudi",
            4 => "Vendredi",
            _ => "Jour " + j
        };
    }

    private IEnumerable<CreneauDto> FilteredCreneaux
    {
        get
        {
            if (creneaux == null) return Enumerable.Empty<CreneauDto>();
            if (filterGroupeId == -1) return creneaux;
            return creneaux.Where(c => c.GroupeId == filterGroupeId);
        }
    }

    private void ShowGrid() { viewMode = "grid"; }
    private void ShowList() { viewMode = "list"; }
    private void ClearSuccess() { successMessage = ""; }
    private void CancelDelete() { deletingCreneau = null; }
    private void OnHeureDebutChanged(ChangeEventArgs e) { editing.HeureDebut = e.Value?.ToString() ?? ""; }
    private void OnHeureFinChanged(ChangeEventArgs e)   { editing.HeureFin   = e.Value?.ToString() ?? ""; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        loadError = "";
        try
        {
            creneaux     = await Http.GetFromJsonAsync<List<CreneauDto>>("api/Creneaux")         ?? new();
            coursOfferts = await Http.GetFromJsonAsync<List<CoursOffertDto>>("api/CoursOfferts") ?? new();
            groupes      = await Http.GetFromJsonAsync<List<GroupeDto>>("api/Groupes")           ?? new();
        }
        catch (Exception ex)
        {
            loadError = "Erreur de chargement : " + ex.Message;
            creneaux  = new();
        }
    }

    private void CloseModal()
    {
        showModal       = false;
        submitAttempted = false;
        modalError      = "";
    }

    private void OpenCreateModal()
    {
        editing    = new CreneauFormDto { JourSemaine = 0, HeureDebut = "08:30", HeureFin = "11:30" };
        modalTitle = "Nouveau créneau";
        CloseModal();
        showModal = true;
    }

    private void OpenEditModal(CreneauDto c)
    {
        editing = new CreneauFormDto
        {
            Id            = c.Id,
            CoursOffertId = c.CoursOffertId,
            JourSemaine   = c.JourSemaine,
            HeureDebut    = c.HeureDebut,
            HeureFin      = c.HeureFin,
            Salle         = c.Salle
        };
        modalTitle = "Modifier le créneau";
        CloseModal();
        showModal = true;
    }

    private async Task SaveCreneau()
    {
        submitAttempted = true;
        modalError      = "";

        if (editing.CoursOffertId == 0)
        {
            modalError = "Veuillez choisir un cours offert.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editing.HeureDebut) || string.IsNullOrWhiteSpace(editing.HeureFin))
        {
            modalError = "Veuillez indiquer les heures.";
            return;
        }

        saving = true;
        try
        {
            HttpResponseMessage res;
            if (editing.Id == 0)
                res = await Http.PostAsJsonAsync("api/Creneaux", editing);
            else
                res = await Http.PutAsJsonAsync("api/Creneaux/" + editing.Id, editing);

            if (res.IsSuccessStatusCode)
            {
                successMessage = editing.Id == 0 ? "Créneau créé !" : "Créneau modifié !";
                CloseModal();
                creneaux = await Http.GetFromJsonAsync<List<CreneauDto>>("api/Creneaux") ?? new();
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                modalError = "Erreur " + (int)res.StatusCode + " : " + body;
            }
        }
        catch (Exception ex)
        {
            modalError = "Erreur réseau : " + ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private void AskDelete(CreneauDto c)
    {
        deletingCreneau = c;
    }

    private async Task DeleteConfirmed()
    {
        if (deletingCreneau == null) return;
        try
        {
            var res = await Http.DeleteAsync("api/Creneaux/" + deletingCreneau.Id);
            successMessage = res.IsSuccessStatusCode ? "Créneau supprimé." : "Erreur lors de la suppression.";
            creneaux = await Http.GetFromJsonAsync<List<CreneauDto>>("api/Creneaux") ?? new();
        }
        catch
        {
            successMessage = "Erreur réseau lors de la suppression.";
        }
        deletingCreneau = null;
    }

    public class CreneauDto
    {
        public int     Id            { get; set; }
        public int     CoursOffertId { get; set; }
        public string  CoursNom      { get; set; } = "";
        public string  GroupeNom     { get; set; } = "";
        public int     GroupeId      { get; set; }
        public string  EnseignantNom { get; set; } = "";
        public int     JourSemaine   { get; set; }
        public string  HeureDebut    { get; set; } = "";
        public string  HeureFin      { get; set; } = "";
        public string? Salle         { get; set; }
    }

    public class CreneauFormDto
    {
        public int     Id            { get; set; }
        public int     CoursOffertId { get; set; }
        public int     JourSemaine   { get; set; }
        public string  HeureDebut    { get; set; } = "";
        public string  HeureFin      { get; set; } = "";
        public string? Salle         { get; set; }
    }

    public class CoursOffertDto
    {
        public int    Id            { get; set; }
        public string CoursNom      { get; set; } = "";
        public string GroupeNom     { get; set; } = "";
        public string EnseignantNom { get; set; } = "";
    }

    public class GroupeDto
    {
        public int    Id  { get; set; }
        public string Nom { get; set; } = "";
    }
}
